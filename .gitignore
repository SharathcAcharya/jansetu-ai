# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & os
.DS_Store
Thumbs.db
*.swp
*.swo

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# ===================================================
# CREDENTIALS, SECRETS & ENVIRONMENT FILES (SECURITY)
# ===================================================

# Environment variable files (prevent API keys and secrets leakage)
.env
.env*
.env.*
env.local
*.env
*.env.local
.envrc
# Whitelist example / template config files
!.env.example
!.env*.example
!.env.template

# Google Cloud & Firebase Service Account credentials & private keys
*firebase*.json
*service-account*.json
*serviceAccount*.json
*service-account-key*.json
serviceAccountKey.json
service-account.json
*firebase-adminsdk*.json
*client_secret*.json
google-services.json
GoogleService-Info.plist
credentials.json
gcp-credentials.json
service-account-credentials.json

# Private keys, certificates, keystores, and SSH keys
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.pkcs12
*.crt
*.cer
*.der
id_rsa*
id_ed25519*
id_ecdsa*

# Package manager & developer CLI auth tokens
.npmrc
.yarnrc
.yarnrc.yml
.netrc

# Dedicated secret, cert, and credential directories
secrets/
credentials/
certs/
*.secret
*.secrets

# Firebase emulator and CLI cache
.firebase/

# Local databases, dumps, and backup files
*.sqlite
*.sqlite3
*.db
*.dump
*.sql
*.bak
*.backup

# vercel
.vercel

# typescript & ide
*.tsbuildinfo
next-env.d.ts
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

